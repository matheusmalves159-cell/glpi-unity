{# Tabela de reservas usada em "Minhas reservas" e em "Reservas da empresa" (mostrar_quem) #}
<style>
    .sr-lista .sr-abas { display: flex; flex-wrap: wrap; gap: .5rem; }
    .sr-lista .sr-reservas td { vertical-align: middle; }
    .sr-lista .sr-reservas tr.sr-apagada > td { opacity: .7; }
    .sr-lista .sr-resumo .card-body { padding: .75rem 1rem; }
</style>
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table sr-reservas">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Horário</th>
                    <th>Sala</th>
                    {% if mostrar_quem %}<th>Responsável</th>{% endif %}
                    <th class="text-center">Pessoas</th>
                    <th>Tipo</th>
                    <th>Assunto</th>
                    <th>Chamado</th>
                    <th>Situação</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for r in reservas %}
                    <tr class="{{ r.situacao != 'confirmada' ? 'sr-apagada' }}">
                        <td class="text-nowrap">{{ r.data }} <span class="text-muted small">{{ r.semana }}</span></td>
                        <td class="text-nowrap">{{ r.inicio }} – {{ r.fim }}<div class="text-muted small">{{ r.duracao }}</div></td>
                        <td>{{ r.sala }}{% if r.local %}<div class="text-muted small">{{ r.local }}</div>{% endif %}</td>
                        {% if mostrar_quem %}<td>{{ r.quem }}</td>{% endif %}
                        <td class="text-center">{{ r.pessoas }}</td>
                        <td>{{ r.tipo }}</td>
                        <td>{{ r.assunto|default('—') }}</td>
                        <td>
                            {% if r.chamado %}
                                <a href="{{ path('/front/ticket.form.php') }}?id={{ r.chamado }}">#{{ r.chamado }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <td>
                            {% if r.situacao == 'cancelada' %}
                                <span class="badge bg-secondary-lt">Cancelada</span>
                            {% elseif r.situacao == 'encerrada' %}
                                <span class="badge bg-azure-lt">Encerrada</span>
                            {% else %}
                                <span class="badge bg-green-lt">Confirmada</span>
                            {% endif %}
                        </td>
                        <td class="text-end text-nowrap">
                            {% if r.pode %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('/plugins/salasreuniao/front/agendar.php') }}?remarcar={{ r.id }}">
                                    <i class="ti ti-calendar-time"></i><span>Remarcar</span>
                                </a>
                                <form method="post" action="{{ path('/plugins/salasreuniao/front/agendar.form.php') }}" class="d-inline sr-form-cancelar"
                                      data-sala="{{ r.sala }}" data-data="{{ r.data }} ({{ r.semana }})" data-horario="{{ r.inicio }} – {{ r.fim }}" data-assunto="{{ r.assunto }}">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="id" value="{{ r.id }}">
                                    <input type="hidden" name="cancelar" value="1">
                                    <button type="button" class="btn btn-sm btn-outline-danger sr-cancelar">
                                        <i class="ti ti-x"></i><span>Cancelar</span>
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Confirmação de cancelamento (no lugar do confirm() do navegador) #}
<div class="modal fade" id="sr-modal-cancelar" tabindex="-1" aria-labelledby="sr-modal-cancelar-titulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content sr-modal">
            <div class="modal-body text-center pt-4 pb-3 px-4">
                <span class="sr-modal-icone"><i class="ti ti-calendar-x"></i></span>
                <h3 class="mt-3 mb-1" id="sr-modal-cancelar-titulo">Cancelar esta reserva?</h3>
                <p class="text-muted mb-3">O horário volta a ficar livre na agenda da sala e o chamado da reserva é fechado.</p>
                <div class="sr-modal-resumo text-start">
                    <div><i class="ti ti-door"></i><strong data-campo="sala"></strong></div>
                    <div><i class="ti ti-calendar"></i><span data-campo="data"></span></div>
                    <div><i class="ti ti-clock"></i><span data-campo="horario"></span></div>
                    <div data-linha="assunto"><i class="ti ti-message"></i><span data-campo="assunto"></span></div>
                </div>
            </div>
            <div class="modal-footer justify-content-center gap-2 pt-0 pb-4 border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="ti ti-arrow-back-up"></i><span>Manter Reserva</span>
                </button>
                <button type="button" class="btn btn-danger" id="sr-confirmar-cancelar">
                    <i class="ti ti-x"></i><span>Sim, Cancelar</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .sr-modal { border-radius: 14px; }
    .sr-modal .sr-modal-icone {
        display: inline-flex; align-items: center; justify-content: center;
        width: 64px; height: 64px; border-radius: 50%;
        font-size: 2rem; color: var(--tblr-danger, #e8590c);
        background: color-mix(in srgb, var(--tblr-danger, #e8590c) 15%, transparent);
    }
    .sr-modal .sr-modal-resumo {
        display: grid; gap: .45rem; padding: .75rem 1rem; border-radius: 10px;
        border: 1px solid var(--tblr-border-color, #dce1e7);
        background: color-mix(in srgb, currentColor 6%, transparent);
    }
    .sr-modal .sr-modal-resumo .ti { width: 1.4rem; margin-right: .4rem; color: var(--tblr-secondary-color, #667382); }
</style>

<script>
(function () {
    var modalEl = document.getElementById('sr-modal-cancelar');
    if (!modalEl || typeof bootstrap === 'undefined') {
        return;
    }
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    var confirmar = document.getElementById('sr-confirmar-cancelar');
    var formAtual = null;

    document.querySelectorAll('.sr-form-cancelar .sr-cancelar').forEach(function (botao) {
        botao.addEventListener('click', function () {
            formAtual = botao.closest('form');
            ['sala', 'data', 'horario', 'assunto'].forEach(function (campo) {
                modalEl.querySelector('[data-campo="' + campo + '"]').textContent = formAtual.dataset[campo] || '';
            });
            modalEl.querySelector('[data-linha="assunto"]').classList.toggle('d-none', !formAtual.dataset.assunto);
            confirmar.disabled = false;
            confirmar.querySelector('span').textContent = 'Sim, Cancelar';
            modal.show();
        });
    });

    confirmar.addEventListener('click', function () {
        if (!formAtual) {
            return;
        }
        confirmar.disabled = true;
        confirmar.querySelector('span').textContent = 'Cancelando…';
        formAtual.submit();
    });
})();
</script>
